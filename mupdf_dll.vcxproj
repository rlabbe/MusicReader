<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" ToolsVersion="17.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!--
    Packages mupdf (built static as libmupdf.lib) into mupdf.dll.

    Why this project exists: Qt is linked statically and bundles its own
    harfbuzz; mupdf also bundles harfbuzz. Two copies of the same hb_* symbols
    cannot coexist in one static image. Building mupdf as a DLL seals its
    harfbuzz (and freetype/zlib/etc.) inside the DLL, where it is never
    exported and therefore can never collide with Qt's copy.

    Nothing in extern\mupdf is modified. libmupdf.lib is built exactly as
    shipped, except FZ_DLL is supplied on the compiler command line (via the
    CL env var, mupdf's own documented switch for "build the DLL") so that
    fz_*/pdf_* get dllexport. /WHOLEARCHIVE then pulls every object from
    libmupdf.lib into the DLL and exports the decorated symbols.
  -->
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="ReleaseDbgInfo|x64">
      <Configuration>ReleaseDbgInfo</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>
  <PropertyGroup Label="Globals">
    <VCProjectVersion>17.0</VCProjectVersion>
    <ProjectGuid>{C7E9A1B2-3D4F-4A5B-9C6D-7E8F90A1B2C3}</ProjectGuid>
    <RootNamespace>mupdf_dll</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <UseDebugLibraries>true</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <UseDebugLibraries>false</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)|$(Platform)'=='ReleaseDbgInfo|x64'" Label="Configuration">
    <ConfigurationType>DynamicLibrary</ConfigurationType>
    <PlatformToolset>v143</PlatformToolset>
    <UseDebugLibraries>false</UseDebugLibraries>
    <CharacterSet>Unicode</CharacterSet>
  </PropertyGroup>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />
  <PropertyGroup Label="MupdfPaths">
    <!-- ReleaseDbgInfo links the Release build of mupdf, matching how MusicReader builds it. -->
    <MupdfLibConfig Condition="'$(Configuration)'=='Debug'">Debug</MupdfLibConfig>
    <MupdfLibConfig Condition="'$(Configuration)'!='Debug'">Release</MupdfLibConfig>
    <MupdfStaticLib>$(SolutionDir)extern\mupdf\platform\win32\x64\$(MupdfLibConfig)\libmupdf.lib</MupdfStaticLib>
  </PropertyGroup>
  <PropertyGroup>
    <OutDir>$(SolutionDir)mupdf_dll_bin\$(Platform)\$(Configuration)\</OutDir>
    <IntDir>$(SolutionDir)mupdf_dll_bin\$(Platform)\$(Configuration)\obj\</IntDir>
    <TargetName>mupdf</TargetName>
  </PropertyGroup>
  <ItemDefinitionGroup>
    <ClCompile>
      <WarningLevel>Level3</WarningLevel>
      <LanguageStandard>stdcpp20</LanguageStandard>
      <SDLCheck>false</SDLCheck>
    </ClCompile>
    <Link>
      <SubSystem>Windows</SubSystem>
      <GenerateDebugInformation>true</GenerateDebugInformation>
      <AdditionalDependencies>$(MupdfStaticLib);kernel32.lib;user32.lib;gdi32.lib;advapi32.lib;shell32.lib;ole32.lib;oleaut32.lib;%(AdditionalDependencies)</AdditionalDependencies>
      <ModuleDefinitionFile>mupdf_exports.def</ModuleDefinitionFile>
      <AdditionalOptions>/IGNORE:4197 %(AdditionalOptions)</AdditionalOptions>
    </Link>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <ClCompile>
      <!-- Must match mupdf's CRT (static). Mismatch yields LNK4098 + __imp_* unresolved. -->
      <RuntimeLibrary>MultiThreadedDebug</RuntimeLibrary>
      <Optimization>Disabled</Optimization>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <ClCompile>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <Optimization>MaxSpeed</Optimization>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(Configuration)|$(Platform)'=='ReleaseDbgInfo|x64'">
    <ClCompile>
      <RuntimeLibrary>MultiThreaded</RuntimeLibrary>
      <Optimization>Disabled</Optimization>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup>
    <ClCompile Include="mupdf_dll_main.cpp" />
  </ItemGroup>
  <!--
    Build libmupdf.lib with FZ_DLL decorations via a Target with Inputs/Outputs
    so MSBuild skips it when the output is already up to date, matching the
    incremental-build behaviour of the rest of the solution.

    Env vars: _CL_ (not CL) so /MTd is APPENDED after mupdf's hardcoded /MDd
    and wins; CL prepends and would lose to the project's command-line /MDd.
  -->
  <ItemGroup>
    <MupdfSourceFiles Include="$(SolutionDir)extern\mupdf\source\**\*.c" />
    <MupdfSourceFiles Include="$(SolutionDir)extern\mupdf\source\**\*.cpp" />
    <MupdfSourceFiles Include="$(SolutionDir)extern\mupdf\include\**\*.h" />
    <MupdfSourceFiles Include="$(SolutionDir)extern\mupdf\platform\win32\**\*.vcxproj" />
    <MupdfSourceFiles Include="$(SolutionDir)extern\mupdf\platform\win32\**\*.sln" />
    <MupdfSourceFiles Include="$(SolutionDir)extern\mupdf\platform\win32\**\*.props" />
    <MupdfSourceFiles Include="$(SolutionDir)extern\mupdf\platform\win32\**\*.targets" />
  </ItemGroup>
  <Target Name="BuildMupdfLib" BeforeTargets="ClCompile"
          Inputs="@(MupdfSourceFiles)"
          Outputs="$(MupdfStaticLib)"
          Condition="'$(Configuration)|$(Platform)'=='Debug|x64'">
    <Message Importance="high" Text="Building mupdf static lib with FZ_DLL /MTd for DLL packaging..." />
    <Exec Command="set CL=/MP /DFZ_DLL&amp;&amp; set _CL_=/MTd&amp;&amp; msbuild &quot;$(SolutionDir)extern\mupdf\platform\win32\mupdf.sln&quot; /p:PlatformToolset=v143 /p:Configuration=$(MupdfLibConfig) /p:Platform=x64 /t:libmupdf /v:minimal" />
  </Target>
  <Target Name="BuildMupdfLibRelease" BeforeTargets="ClCompile"
          Inputs="@(MupdfSourceFiles)"
          Outputs="$(MupdfStaticLib)"
          Condition="'$(Configuration)|$(Platform)'=='Release|x64'">
    <Message Importance="high" Text="Building mupdf static lib with FZ_DLL /MT for DLL packaging..." />
    <Exec Command="set CL=/MP /DFZ_DLL&amp;&amp; set _CL_=/MT&amp;&amp; msbuild &quot;$(SolutionDir)extern\mupdf\platform\win32\mupdf.sln&quot; /p:PlatformToolset=v143 /p:Configuration=$(MupdfLibConfig) /p:Platform=x64 /t:libmupdf /v:minimal" />
  </Target>
  <Target Name="BuildMupdfLibReleaseDbgInfo" BeforeTargets="ClCompile"
          Inputs="@(MupdfSourceFiles)"
          Outputs="$(MupdfStaticLib)"
          Condition="'$(Configuration)|$(Platform)'=='ReleaseDbgInfo|x64'">
    <Message Importance="high" Text="Building mupdf static lib with FZ_DLL /MT for DLL packaging..." />
    <Exec Command="set CL=/MP /DFZ_DLL&amp;&amp; set _CL_=/MT&amp;&amp; msbuild &quot;$(SolutionDir)extern\mupdf\platform\win32\mupdf.sln&quot; /p:PlatformToolset=v143 /p:Configuration=$(MupdfLibConfig) /p:Platform=x64 /t:libmupdf /v:minimal" />
  </Target>
  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
